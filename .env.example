# Backend
FLASK_ENV=development
SECRET_KEY=change-me
DATABASE_URL=postgresql+psycopg2://bpa:bpa@localhost:5432/bpa
JWT_SECRET_KEY=change-me-too

# AI provider (server-side only, never expose to the frontend)
AI_PROVIDER=groq
GROQ_API_KEY=
# Empty means openai/gpt-oss-120b
AI_MODEL=
AI_REQUEST_TIMEOUT_SECONDS=30
# Monthly cost cap in USD, across all users; enforced by the backend usage tracker
AI_MONTHLY_COST_CAP_USD=10
# USD per million tokens for AI_MODEL, used to compute cost (check Groq's current pricing)
AI_INPUT_PRICE_PER_MTOK_USD=0.15
AI_OUTPUT_PRICE_PER_MTOK_USD=0.75
# Tool-call rounds per question, and questions per user per minute
AI_MAX_TOOL_ROUNDS=5
AI_REQUESTS_PER_MINUTE=10

# Defaults (DECISIONS.md)
DEFAULT_CURRENCY=MAD

# Email: "console" prints emails (reset and invite links) in the backend log instead of sending.
# Switch to "resend" once a domain is verified in Resend; use a sending-only key restricted to that domain.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=BusinessProjectAssistance <no-reply@mail.yourdomain.com>
# Frontend address used in emailed links
APP_BASE_URL=http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:5000/api
