# Backend
FLASK_ENV=development
SECRET_KEY=change-me
DATABASE_URL=postgresql+psycopg2://bpa:bpa@localhost:5432/bpa
JWT_SECRET_KEY=change-me-too

# AI provider (server-side only, never expose to the frontend)
AI_PROVIDER=groq
GROQ_API_KEY=
AI_MODEL=
AI_REQUEST_TIMEOUT_SECONDS=30
# Monthly cost cap in USD; enforced by the backend usage tracker
AI_MONTHLY_COST_CAP_USD=10

# Defaults (DECISIONS.md)
DEFAULT_CURRENCY=MAD

# Frontend
VITE_API_BASE_URL=http://localhost:5000/api
